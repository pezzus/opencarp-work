# Atrial 225-um monodomain benchmark.
# Region definitions below are preserved from the supplied Loewe parameters.
# Run from the directory containing atrial/mesh/P1_225um_spl.*.
# dt is in microseconds; tend, spacedt and timedt are in milliseconds.
meshname = atrial/mesh/P1_225um_spl
dt = 50
tend = 100
bidomain = 0
bidm_eqv_mono = 1
mass_lumping = 0
operator_splitting = 1
parab_solve = 1
cg_tol_parab = 0.0001
pstrat = 2
output_level = 1

# Normal output, matching the supplied launch script.
gridout_i = 2
dataout_i = 2
gridout_e = 0
dataout_e = 0
spacedt = 1
timedt = 1
vofile = vm_last_beat

# The supplied script had four unconfigured retagging regions (empty selections).
# Use mesh tags as stored. If fibrosis/scar retagging is required, first supply
# valid refined-mesh region lists or bake their tags into the refined mesh.
